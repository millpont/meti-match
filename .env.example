# Copy to .env (repo root, dot-prefixed — backend/config.py loads exactly that filename) and
# fill in real values. Never commit the real .env.

# Flask
APP_SECRET_KEY=
ENVIRONMENT=development
APP_BASE=/

# Auth0 — same tenant/app registration as before; unchanged by the METI Match rebuild.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CALLBACK_URL=http://localhost:5000/callback

# Database — the NEW, standalone Supabase project created for METI Match (see
# plans/meti-match/01-architecture.md), NOT METI's original instance.
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Supabase REST (PostgREST) — sb.py talks to the DB through this, not direct Postgres.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bootstrap-only: lets the very first admin act before any accounts.role='admin' row exists.
# Leave unset once at least one real admin account exists.
SUPERADMIN_ACCOUNT_ID=
